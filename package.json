{
  "name": "arknights-gacha-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "明日方舟 - 寻访模拟器 | Arknights Headhunt Simulator",
  "author": "Arknights Gacha Simulator",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --win --x64 --publish=never",
    "electron:portable": "vite build && electron-builder --win portable --x64 --publish=never"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "resedit": "^3.1.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.arknights.gacha.simulator",
    "productName": "明日方舟寻访模拟器",
    "copyright": "Copyright © 2026 Arknights Gacha Simulator",
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "sign": null,
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
